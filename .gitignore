# =============================================================
# .gitignore for connes-cvs
# =============================================================

# ---- Python caches and build artifacts ----
# Generated build output is recreated from source and is not versioned.
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
*.whl
*.pickle
.pytest_cache/
.venv/
venv/

# ---- Local secrets ----
.env
.env.*
!.env.example

# ---- OS / editor ----
.DS_Store
.vscode/

# ---- PyPI release staging (built artifacts, never committed) ----
release-dist/
